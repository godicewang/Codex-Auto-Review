{
  "description": "静默只读审计；在下次输入时传达队列中的完整报告，最多 48000 字符。",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/dispatch.mjs\"",
            "commandWindows": "node \"%PLUGIN_ROOT%/hooks/dispatch.mjs\"",
            "timeout": 30,
            "additionalContextLimit": 0
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/dispatch.mjs\"",
            "commandWindows": "node \"%PLUGIN_ROOT%/hooks/dispatch.mjs\"",
            "timeout": 30
          }
        ]
      }
    ],
    "Interrupt": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/dispatch.mjs\"",
            "commandWindows": "node \"%PLUGIN_ROOT%/hooks/dispatch.mjs\"",
            "timeout": 3
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/dispatch.mjs\"",
            "commandWindows": "node \"%PLUGIN_ROOT%/hooks/dispatch.mjs\"",
            "timeout": 3
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Bash|apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/dispatch.mjs\"",
            "commandWindows": "node \"%PLUGIN_ROOT%/hooks/dispatch.mjs\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Bash|apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/dispatch.mjs\"",
            "commandWindows": "node \"%PLUGIN_ROOT%/hooks/dispatch.mjs\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
